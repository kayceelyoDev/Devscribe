datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model User {
  id              String          @id @default(uuid())
  username        String          @unique
  email           String?         @unique
  passwordHash    String
  recoveryKeyHash String
  name            String?
  avatarUrl       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  settings        UserSettings?
  documents       Document[]
  flashcardDecks  FlashcardDeck[]
  grammarAudits   GrammarAudit[]
  codeReviews     CodeReview[]
  examSessions    ExamSession[]
  telemetryLogs   TelemetryLog[]

  @@index([username])
}

model UserSettings {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeProvider      String   @default("local")
  ollamaBaseUrl       String   @default("http://host.docker.internal:11434/v1")
  localModelName      String   @default("qwen3:4b")
  localEmbeddingModel String   @default("nomic-embed-text")
  encryptedGeminiKey  String?
  temperature         Float    @default(0.2)
  maxChunkTokens      Int      @default(1000)
  theme               String   @default("dark")
  updatedAt           DateTime @updatedAt
}

model Document {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  fileKey     String
  fileSize    Int
  mimeType    String
  contentHash String
  rawText     String          @db.Text
  createdAt   DateTime        @default(now())

  chunks       DocumentChunk[]
  decks        FlashcardDeck[]
  examSessions ExamSession[]

  @@index([userId])
  @@index([contentHash])
}

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  heading    String?
  content    String   @db.Text
  tokenCount Int
  embedding  Json?

  @@index([documentId, chunkIndex])
}

model FlashcardDeck {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId  String?
  document    Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  title       String
  description String?
  sourceType  String      @default("document")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  cards Flashcard[]

  @@index([userId])
}

model Flashcard {
  id            String        @id @default(uuid())
  deckId        String
  deck          FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  front         String        @db.Text
  back          String        @db.Text
  codeSnippet   String?       @db.Text
  tags          String[]      @default([])
  due           DateTime      @default(now())
  stability     Float         @default(0.0)
  difficulty    Float         @default(0.0)
  elapsedDays   Int           @default(0)
  scheduledDays Int           @default(0)
  reps          Int           @default(0)
  lapses        Int           @default(0)
  state         Int           @default(0)
  lastReview    DateTime?

  @@index([deckId, due])
}

model GrammarAudit {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String   @default("Untitled Document")
  originalText String   @db.Text
  revisedText  String   @db.Text
  issuesJson   Json
  toneApplied  String   @default("professional")
  score        Int      @default(100)
  createdAt    DateTime @default(now())

  @@index([userId])
}

model CodeReview {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String   @default("Code Inspection")
  language      String   @default("typescript")
  inputCode     String   @db.Text
  optimizedCode String   @db.Text
  explanation   String   @db.Text
  mermaidGraph  String?  @db.Text
  complexity    Json
  findings      Json
  createdAt     DateTime @default(now())

  @@index([userId])
}

model ExamSession {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId   String?
  document     Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  mode         String    @default("oral_quiz")
  topic        String
  difficulty   String    @default("intermediate")
  history      Json
  averageScore Float     @default(0.0)
  completed    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

model TelemetryLog {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider         String
  modelName        String
  feature          String
  promptTokens     Int
  completionTokens Int
  durationMs       Int
  tokensPerSecond  Float
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
}
