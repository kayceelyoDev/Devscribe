# ========================================================
# DEVSCRIBE - LAPTOP DEVELOPMENT CONFIGURATION
# ========================================================
# Copy this file to .env on your development laptop:
# cp .env.laptop.example .env

# Database: Connect to your local PostgreSQL (managed via pgAdmin 4)
# Adjust user, password, and port if your pgAdmin / local Postgres uses different credentials:
# Example: postgresql://postgres:yourpassword@localhost:5432/devscribe?schema=public
DATABASE_URL="postgresql://postgres:yashu5368@localhost:5432/devscribe?schema=public"

# Redis Cache & Mutex:
# If you don't have Redis installed on your laptop, DevScribe automatically
# uses an in-memory lock & cache fallback during development!
# Or point to your Ubuntu server LAN IP (e.g. redis://:devscribe@192.168.1.50:6379):
REDIS_URL="redis://:devscribe@localhost:6379"

# MinIO / S3 Storage:
# If you don't have MinIO running on your laptop, DevScribe automatically
# stores uploaded documents in the local .storage/ directory!
# Or point to your Ubuntu server LAN IP (e.g. http://192.168.1.50:9000):
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="devscribe"
S3_SECRET_KEY="devscribe-secret"
S3_BUCKET_NAME="devscribe-files"

# Authentication & Session (NextAuth v5):
AUTH_SECRET="devscribe-local-auth-secret-32-chars-long-key-12345"
AUTH_URL="http://localhost:3000"

# AES-256-GCM 64-character hex encryption key for Gemini API keys at rest:
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Ollama Local AI:
# Point to Ollama running locally or on your Ubuntu server over LAN:
OLLAMA_BASE_URL="http://localhost:11434/v1"
LOCAL_MODEL_NAME="qwen3:4b"
LOCAL_EMBEDDING_MODEL="nomic-embed-text"

# Optional Cloud Gemini Key:
GOOGLE_GENERATIVE_AI_API_KEY=""

# Skip validation during local startup if external services are booting:
SKIP_ENV_VALIDATION="1"
