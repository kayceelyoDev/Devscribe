# ========================================================
# DEVSCRIBE - UBUNTU SERVER PRODUCTION CONFIGURATION
# ========================================================
# Copy this file to .env on your Ubuntu server:
# cp .env.ubuntu.example .env

# Database: Connects inside Docker network to PostgreSQL 16 container
DATABASE_URL="postgresql://devscribe:devscribe@postgres:5432/devscribe?schema=public"

# Redis Cache: Connects inside Docker network to Redis 7 container
REDIS_URL="redis://:devscribe@redis:6379"

# MinIO Storage: Connects inside Docker network to MinIO container
S3_ENDPOINT="http://minio:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="devscribe"
S3_SECRET_KEY="devscribe-secret"
S3_BUCKET_NAME="devscribe-files"

# Authentication & Session (NextAuth v5):
# Generate a random 32+ character secret for production:
AUTH_SECRET="devscribe-ubuntu-prod-secret-change-me-32-chars-long"
AUTH_URL="http://localhost:3000"

# AES-256-GCM 64-character hex encryption key:
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Ollama: Communicates with native Ollama on the Ubuntu host
OLLAMA_BASE_URL="http://host.docker.internal:11434/v1"
LOCAL_MODEL_NAME="qwen3:4b"
LOCAL_EMBEDDING_MODEL="nomic-embed-text"

# Optional Cloud Gemini Key:
GOOGLE_GENERATIVE_AI_API_KEY=""

# Skip validation during docker build:
SKIP_ENV_VALIDATION="1"
